generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Roles ───

enum UserRole {
  TRADER
  ADMIN
  SUPPORT
  MERCHANT
  OWNER
  REFERRAL
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  twoFaSecret   String?   @map("two_fa_secret")
  referredById  String?   @map("referred_by_id") @db.Uuid
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions                    Session[]
  merchant                    Merchant?
  traderProfile               TraderProfile?
  referralProfile             ReferralProfile?
  referrer                    ReferralProfile?     @relation("ReferredUsers", fields: [referredById], references: [id])
  auditLogs                   AuditLog[]
  settlements                 Settlement[]         @relation("SettlementAdmin")
  uploadedFiles               File[]
  balanceTransactionsCreated  BalanceTransaction[] @relation("BalanceTxCreator")
  platformWithdrawals         PlatformWithdrawal[]

  @@index([referredById])
  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Referral Profiles ───

model ReferralProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  referralPercent Decimal  @default(0) @map("referral_percent") @db.Decimal(8, 4)
  balance         Decimal  @default(0) @db.Decimal(18, 4)
  currency        String   @default("UAH")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals User[] @relation("ReferredUsers")

  @@map("referral_profiles")
}

// ─── Merchants ───

model Merchant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String
  isLock    Boolean  @default(false) @map("is_lock")
  createdAt DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys                     MerchantApiKey[]
  balances                    MerchantBalance[]
  payinOrders                 PayinOrder[]
  payoutOrders                PayoutOrder[]
  merchantDirections          MerchantDirection[]
  merchantBalanceTransactions MerchantBalanceTransaction[]
  platformIncomeRows          PlatformIncome[]

  @@map("merchants")
}

enum ApiKeyDirection {
  PAYIN
  PAYOUT
}

model MerchantApiKey {
  id            String          @id @default(uuid()) @db.Uuid
  merchantId    String          @map("merchant_id") @db.Uuid
  direction     ApiKeyDirection
  publicKey     String          @unique @map("public_key")
  secretKeyHash String          @map("secret_key_hash")
  isActive      Boolean         @default(true) @map("is_active")
  revokedAt     DateTime?       @map("revoked_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([publicKey])
  @@index([merchantId, direction])
  @@map("merchant_api_keys")
}

model MerchantBalance {
  id         String  @id @default(uuid()) @db.Uuid
  merchantId String  @map("merchant_id") @db.Uuid
  currency   String
  amount     Decimal @default(0) @db.Decimal(18, 4)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, currency])
  @@map("merchant_balances")
}

// ─── Currencies & Directions ───

model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  @@map("currencies")
}

enum DirectionType {
  PAYIN
  PAYOUT
}

model Direction {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  type         DirectionType
  fromCurrency String        @map("from_currency")
  toCurrency   String        @map("to_currency")
  minAmount    Decimal       @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount    Decimal       @default(0) @map("max_amount") @db.Decimal(18, 4)
  rate         Decimal       @default(1) @db.Decimal(18, 8)
  percentFee   Decimal       @default(0) @map("percent_fee") @db.Decimal(8, 4)
  isOnline     Boolean       @default(true) @map("is_online")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("directions")
}

// ─── Geo: Countries ───

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  currency  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  paymentMethods PaymentMethod[]

  @@map("countries")
}

// ─── Payment Methods ───

enum PaymentMethodFlowType {
  P2P
  P2C
  CRYPTO
}

enum PaymentMethodRequisiteType {
  CARD
  IBAN
  WALLET
}

enum PaymentMethodAvailability {
  PAYIN
  PAYOUT
  BOTH
}

model PaymentMethod {
  id            String                     @id @default(uuid()) @db.Uuid
  countryId     String                     @map("country_id") @db.Uuid
  name          String                     @unique
  displayName   String                     @map("display_name")
  flowType      PaymentMethodFlowType      @map("flow_type")
  requisiteType PaymentMethodRequisiteType @map("requisite_type")
  availability  PaymentMethodAvailability
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at")

  country            Country             @relation(fields: [countryId], references: [id])
  merchantDirections MerchantDirection[]
  payinOrders        PayinOrder[]
  payoutOrders       PayoutOrder[]
  requisiteGroups    RequisiteGroup[]

  @@index([countryId, isActive])
  @@map("payment_methods")
}

// ─── Merchant Directions (per-merchant settings) ───

model MerchantDirection {
  id                      String        @id @default(uuid()) @db.Uuid
  merchantId              String        @map("merchant_id") @db.Uuid
  paymentMethodId         String?       @map("payment_method_id") @db.Uuid
  directionType           DirectionType @map("direction_type")
  currency                String
  minAmount               Decimal       @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount               Decimal       @default(0) @map("max_amount") @db.Decimal(18, 4)
  defaultCommissionPercent Decimal      @default(0) @map("default_commission_percent") @db.Decimal(8, 4)
  isActive                Boolean       @default(true) @map("is_active")
  createdAt               DateTime      @default(now()) @map("created_at")

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  commissionTiers MerchantCommissionTier[]

  @@unique([merchantId, directionType, currency])
  @@index([merchantId, directionType])
  @@map("merchant_directions")
}

// ─── Merchant Commission Tiers ───

model MerchantCommissionTier {
  id                  String   @id @default(uuid()) @db.Uuid
  merchantDirectionId String   @map("merchant_direction_id") @db.Uuid
  amountFrom          Decimal  @map("amount_from") @db.Decimal(18, 4)
  amountTo            Decimal? @map("amount_to") @db.Decimal(18, 4)
  commissionPercent   Decimal  @map("commission_percent") @db.Decimal(8, 4)

  merchantDirection MerchantDirection @relation(fields: [merchantDirectionId], references: [id], onDelete: Cascade)

  @@index([merchantDirectionId])
  @@map("merchant_commission_tiers")
}

// ─── Balance Transactions ───

enum BalanceTransactionType {
  PAYIN_COMMISSION
  PAYIN_DEBIT
  PAYOUT_DEBIT
  PAYOUT_CREDIT
  TOP_UP
  OVERDRAFT_SET
  SETTLEMENT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

model BalanceTransaction {
  id          String                 @id @default(uuid()) @db.Uuid
  traderId    String                 @map("trader_id") @db.Uuid
  type        BalanceTransactionType
  amount      Decimal                @db.Decimal(18, 4)
  currency    String
  referenceId String?                @map("reference_id") @db.Uuid
  createdById String?                @map("created_by_id") @db.Uuid
  comment     String?
  createdAt   DateTime               @default(now()) @map("created_at")

  trader    TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("BalanceTxCreator", fields: [createdById], references: [id])

  @@index([traderId])
  @@index([createdAt])
  @@map("balance_transactions")
}

// ─── Traders & Requisites ───

model TraderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  acceptingOrders Boolean  @default(true) @map("accepting_orders")
  payoutMinLimit  Decimal  @default(0) @map("payout_min_limit") @db.Decimal(18, 4)
  payoutMaxLimit  Decimal  @default(0) @map("payout_max_limit") @db.Decimal(18, 4)
  /// USDT overdraft limit (0 = no overdraft). Available for Pay-In assignment = balance_usdt + overdraft_limit.
  overdraftLimit  Decimal  @default(0) @map("overdraft_limit") @db.Decimal(18, 6)
  /// Trader Pay-In rate as fraction (0.01 = +1% on parser rate divisor).
  payinRate       Decimal  @default(0) @map("payin_rate") @db.Decimal(8, 6)
  /// Trader Pay-Out rate as fraction (0.002 = 0.2% better credit).
  payoutRate      Decimal  @default(0) @map("payout_rate") @db.Decimal(8, 6)
  /// TRC-20 receiving address for USDT top-ups (Tron). Monitored by deposit worker when set.
  usdtTrc20DepositAddress String? @map("usdt_trc20_deposit_address") @db.VarChar(64)
  /// ERC-20 receiving address for USDT top-ups (Ethereum mainnet). Monitored by ERC-20 deposit worker when set.
  usdtErc20DepositAddress String? @map("usdt_erc20_deposit_address") @db.VarChar(42)
  createdAt       DateTime @default(now()) @map("created_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances            TraderBalance[]
  requisites          Requisite[]
  requisiteGroups     RequisiteGroup[]
  payinOrders         PayinOrder[]
  payoutOrders        PayoutOrder[]
  telegramSettings    TelegramSettings?
  settlements         Settlement[]
  balanceTransactions BalanceTransaction[]
  walletDeposits      WalletDeposit[]
  platformIncomeRows  PlatformIncome[]

  @@map("trader_profiles")
}

model TraderBalance {
  id       String  @id @default(uuid()) @db.Uuid
  traderId String  @map("trader_id") @db.Uuid
  currency String
  amount   Decimal @default(0) @db.Decimal(18, 4)

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, currency])
  @@map("trader_balances")
}

enum RequisiteType {
  CARD
  IBAN
}

enum RequisiteDisabledReason {
  LIMIT_AMOUNT
  LIMIT_TX
  MANUAL
}

model RequisiteGroup {
  id              String    @id @default(uuid()) @db.Uuid
  traderId        String    @map("trader_id") @db.Uuid
  name            String
  currency        String    @default("UAH")
  paymentMethodId String?   @map("payment_method_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  archivedAt      DateTime? @map("archived_at")
  deactivatedAt   DateTime? @map("deactivated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trader         TraderProfile  @relation(fields: [traderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  requisites     Requisite[]

  @@index([traderId, archivedAt])
  @@map("requisite_groups")
}

model Requisite {
  id                String                   @id @default(uuid()) @db.Uuid
  traderId          String                   @map("trader_id") @db.Uuid
  requisiteGroupId  String                   @map("requisite_group_id") @db.Uuid
  type              RequisiteType
  number            String
  owner             String
  bankId            Int?                     @map("bank_id")
  code              String?
  isActive          Boolean                  @default(true) @map("is_active")
  disabledReason    RequisiteDisabledReason? @map("disabled_reason")
  acceptsOtherBanks Boolean                  @default(false) @map("accepts_other_banks")
  minAmount         Decimal                  @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount         Decimal                  @default(999999999) @map("max_amount") @db.Decimal(18, 4)
  limitTotalAmount  Decimal                  @default(999999999) @map("limit_total_amount") @db.Decimal(18, 4)
  limitTotalOps     Int                      @default(999999) @map("limit_total_ops")
  usedAmount        Decimal                  @default(0) @map("used_amount") @db.Decimal(18, 4)
  usedOps           Int                      @default(0) @map("used_ops")
  currency          String                   @default("UAH")
  createdAt         DateTime                 @default(now()) @map("created_at")

  trader        TraderProfile  @relation(fields: [traderId], references: [id], onDelete: Cascade)
  group         RequisiteGroup @relation(fields: [requisiteGroupId], references: [id], onDelete: Restrict)
  bank          Bank?          @relation(fields: [bankId], references: [id])
  payinOrders   PayinOrder[]

  @@index([traderId, isActive])
  @@index([currency, isActive])
  @@index([requisiteGroupId])
  @@map("requisites")
}

// ─── Banks ───

model Bank {
  id        Int     @id @default(autoincrement())
  name      String
  logoFileId String? @map("logo_file_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")

  logoFile   File?       @relation(fields: [logoFileId], references: [id])
  requisites Requisite[]

  @@map("banks")
}

// ─── Pay-In Orders ───

enum PayinStatus {
  PENDING
  NEW
  VERIFIED
  PAID
  UNDERPAID
  OVERPAID
  APPEAL
  CANCELED
  UPLOAD_FAILED
}

model PayinOrder {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @map("request_id")
  merchantId        String      @map("merchant_id") @db.Uuid
  traderId          String?     @map("trader_id") @db.Uuid
  requisiteId       String?     @map("requisite_id") @db.Uuid
  paymentMethodId   String?     @map("payment_method_id") @db.Uuid
  amount            Decimal     @db.Decimal(18, 4)
  currency          String
  commissionPercent Decimal     @default(0) @map("commission_percent") @db.Decimal(8, 4)
  commission        Decimal     @default(0) @db.Decimal(18, 4)
  partnerAmount     Decimal     @default(0) @map("partner_amount") @db.Decimal(18, 4)
  rate              Decimal     @default(1) @db.Decimal(18, 8)
  /// Binance P2P parser rate P (UAH per 1 USDT) fixed at order creation.
  parserRate        Decimal?    @map("parser_rate") @db.Decimal(12, 6)
  rateTraderIn      Decimal?    @map("rate_trader_in") @db.Decimal(12, 6)
  rateAdminIn       Decimal?    @map("rate_admin_in") @db.Decimal(12, 6)
  status            PayinStatus @default(PENDING)
  userFullName      String?     @map("user_full_name")
  userIdExternal    String?     @map("user_id_external")
  callbackUrl       String?     @map("callback_url")
  redirectUrl       String?     @map("redirect_url")
  autocloseAt       DateTime?   @map("autoclose_at")
  confirmedAt       DateTime?   @map("confirmed_at")
  completedAt       DateTime?   @map("completed_at")
  isH2h             Boolean     @default(false) @map("is_h2h")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  trader        TraderProfile? @relation(fields: [traderId], references: [id])
  requisite     Requisite?     @relation(fields: [requisiteId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  appeals       Appeal[]
  webhookOutbox WebhookOutbox[]

  @@unique([merchantId, requestId])
  @@index([status])
  @@index([merchantId])
  @@index([traderId])
  @@index([createdAt])
  @@map("payin_orders")
}

// ─── Pay-Out Orders ───

enum PayoutStatus {
  PENDING
  NEW
  PROCESSING
  COMPLETED
  FAILED
  UPLOAD_FAILED
}

enum PayoutDetailsType {
  CARD
  IBAN
}

model PayoutOrder {
  id              String            @id @default(uuid()) @db.Uuid
  requestId       String            @map("request_id")
  merchantId      String            @map("merchant_id") @db.Uuid
  traderId        String?           @map("trader_id") @db.Uuid
  paymentMethodId String?           @map("payment_method_id") @db.Uuid
  amount          Decimal           @db.Decimal(18, 4)
  currency        String
  status          PayoutStatus      @default(PENDING)
  detailsType     PayoutDetailsType @map("details_type")
  detailsNumber   String            @map("details_number")
  detailsOwner    String?           @map("details_owner")
  detailsCode     String?           @map("details_code")
  rate            Decimal           @default(1) @db.Decimal(18, 8)
  commissionAmount Decimal          @default(0) @map("commission_amount") @db.Decimal(18, 4)
  partnerAmount   Decimal           @default(0) @map("partner_amount") @db.Decimal(18, 4)
  percentFee      Decimal           @default(0) @map("percent_fee") @db.Decimal(8, 4)
  parserRate      Decimal?          @map("parser_rate") @db.Decimal(12, 6)
  rateTraderOut   Decimal?          @map("rate_trader_out") @db.Decimal(12, 6)
  rateAdminOut    Decimal?          @map("rate_admin_out") @db.Decimal(12, 6)
  /// Total UAH reserved from merchant at creation: face amount × (1 + commission).
  merchantDebitUah Decimal?         @map("merchant_debit_uah") @db.Decimal(18, 2)
  callbackUrl     String?           @map("callback_url")
  startAt         DateTime?         @map("start_at")
  endAt           DateTime?         @map("end_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  trader        TraderProfile? @relation(fields: [traderId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  webhookOutbox WebhookOutbox[]

  @@unique([merchantId, requestId])
  @@index([status])
  @@index([merchantId])
  @@index([traderId])
  @@index([createdAt])
  @@map("payout_orders")
}

// ─── Appeals ───

enum AppealStatusEnum {
  OPEN
  RESOLVED
  REJECTED
}

model Appeal {
  id           String           @id @default(uuid()) @db.Uuid
  payinOrderId String           @map("payin_order_id") @db.Uuid
  paidAmount   Decimal          @map("paid_amount") @db.Decimal(18, 4)
  status       AppealStatusEnum @default(OPEN)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  payinOrder PayinOrder    @relation(fields: [payinOrderId], references: [id])
  proofs     AppealProof[]

  @@index([payinOrderId])
  @@map("appeals")
}

model AppealProof {
  id       String @id @default(uuid()) @db.Uuid
  appealId String @map("appeal_id") @db.Uuid
  fileId   String @map("file_id") @db.Uuid

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id])

  @@map("appeal_proofs")
}

// ─── Files ───

model File {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  s3Key        String   @map("s3_key")
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  uploader     User?         @relation(fields: [uploadedBy], references: [id])
  appealProofs AppealProof[]
  bankLogos    Bank[]

  @@map("files")
}

// ─── Webhook Outbox & Logs ───

enum WebhookOutboxStatusEnum {
  PENDING
  SENT
  FAILED
  DLQ
}

enum WebhookMethodEnum {
  payin_update_status_order
  payout_update_status_order
}

model WebhookOutbox {
  id          String                  @id @default(uuid()) @db.Uuid
  payinOrderId  String?               @map("payin_order_id") @db.Uuid
  payoutOrderId String?               @map("payout_order_id") @db.Uuid
  method      WebhookMethodEnum
  payloadJson Json                    @map("payload_json")
  callbackUrl String                  @map("callback_url")
  status      WebhookOutboxStatusEnum @default(PENDING)
  attempts    Int                     @default(0)
  nextRetryAt DateTime?               @map("next_retry_at")
  createdAt   DateTime                @default(now()) @map("created_at")

  payinOrder  PayinOrder?  @relation(fields: [payinOrderId], references: [id])
  payoutOrder PayoutOrder? @relation(fields: [payoutOrderId], references: [id])
  logs        WebhookLog[]

  @@index([status, nextRetryAt])
  @@map("webhook_outbox")
}

model WebhookLog {
  id             String   @id @default(uuid()) @db.Uuid
  outboxId       String   @map("outbox_id") @db.Uuid
  callbackUrl    String   @map("callback_url")
  requestBody    Json     @map("request_body")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  sentAt         DateTime @default(now()) @map("sent_at")

  outbox WebhookOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId])
  @@map("webhook_logs")
}

// ─── Settlements ───

enum SettlementTypeEnum {
  CREDIT
  DEBIT
}

model Settlement {
  id        String             @id @default(uuid()) @db.Uuid
  adminId   String             @map("admin_id") @db.Uuid
  traderId  String             @map("trader_id") @db.Uuid
  type      SettlementTypeEnum
  amount    Decimal            @db.Decimal(18, 4)
  currency  String
  note      String?
  createdAt DateTime           @default(now()) @map("created_at")

  admin  User          @relation("SettlementAdmin", fields: [adminId], references: [id])
  trader TraderProfile @relation(fields: [traderId], references: [id])

  @@index([traderId])
  @@map("settlements")
}

// ─── Audit Log ───

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Balance model v2: exchange log, platform income, merchant ledger, on-chain scaffolding ───

model ExchangeRateLog {
  id        String   @id @default(uuid()) @db.Uuid
  rate      Decimal  @db.Decimal(12, 6)
  rawPrices Json     @map("raw_prices")
  source    String   @default("binance_p2p")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("exchange_rate_logs")
}

enum PlatformIncomeOrderType {
  PAYIN
  PAYOUT
}

model PlatformIncome {
  id                    String                  @id @default(uuid()) @db.Uuid
  orderId               String                  @map("order_id") @db.Uuid
  orderType             PlatformIncomeOrderType @map("order_type")
  merchantId            String                  @map("merchant_id") @db.Uuid
  traderId              String?                 @map("trader_id") @db.Uuid
  orderAmountUah        Decimal                 @map("order_amount_uah") @db.Decimal(18, 2)
  parserRate            Decimal                 @map("parser_rate") @db.Decimal(12, 6)
  rateTrader            Decimal                 @map("rate_trader") @db.Decimal(12, 6)
  rateAdmin             Decimal                 @map("rate_admin") @db.Decimal(12, 6)
  traderRatePct         Decimal                 @map("trader_rate_pct") @db.Decimal(8, 6)
  merchantCommissionPct Decimal               @map("merchant_commission_pct") @db.Decimal(8, 6)
  incomeUsdt            Decimal                 @map("income_usdt") @db.Decimal(18, 6)
  incomeUah             Decimal                 @map("income_uah") @db.Decimal(18, 2)
  createdAt             DateTime                @default(now()) @map("created_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  trader   TraderProfile?    @relation(fields: [traderId], references: [id], onDelete: SetNull)

  @@unique([orderId, orderType])
  @@index([merchantId])
  @@index([createdAt])
  @@map("platform_income")
}

enum MerchantBalanceTransactionType {
  PAYIN_CREDIT
  PAYOUT_DEBIT
  PAYOUT_REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  TOP_UP
}

model MerchantBalanceTransaction {
  id          String                         @id @default(uuid()) @db.Uuid
  merchantId  String                         @map("merchant_id") @db.Uuid
  type        MerchantBalanceTransactionType
  amount      Decimal                        @db.Decimal(18, 2)
  currency    String
  referenceId String?                        @map("reference_id") @db.Uuid
  comment     String?
  createdAt   DateTime                       @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([createdAt])
  @@map("merchant_balance_transactions")
}

enum BlockchainNetwork {
  TRC20
  ERC20
}

enum WalletDepositStatus {
  PENDING
  CONFIRMED
  CREDITED
}

model WalletDeposit {
  id            String              @id @default(uuid()) @db.Uuid
  traderId      String              @map("trader_id") @db.Uuid
  txHash        String              @unique @map("tx_hash") @db.VarChar(128)
  network       BlockchainNetwork
  amountUsdt    Decimal             @map("amount_usdt") @db.Decimal(18, 6)
  confirmations Int                 @default(0)
  status        WalletDepositStatus @default(PENDING)
  creditedAt    DateTime?           @map("credited_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@map("wallet_deposits")
}

model PlatformWithdrawal {
  id                  String            @id @default(uuid()) @db.Uuid
  amountUsdt          Decimal           @map("amount_usdt") @db.Decimal(18, 6)
  coldWalletAddress   String            @map("cold_wallet_address") @db.VarChar(128)
  network             BlockchainNetwork
  txHash              String?           @map("tx_hash") @db.VarChar(128)
  initiatedById       String?           @map("initiated_by") @db.Uuid
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at")

  initiatedBy User? @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@map("platform_withdrawals")
}

// ─── Platform Settings ───

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

// ─── Telegram Notifications ───

model TelegramSettings {
  id            String  @id @default(uuid()) @db.Uuid
  traderId      String  @unique @map("trader_id") @db.Uuid
  chatId        String? @map("chat_id")
  notifyPayin   Boolean @default(false) @map("notify_payin")
  notifyPayout  Boolean @default(false) @map("notify_payout")
  notifyAppeals Boolean @default(false) @map("notify_appeals")
  isActive      Boolean @default(false) @map("is_active")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@map("telegram_settings")
}
