generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Roles ───

enum UserRole {
  TRADER
  PAYOUT_TRADER
  ADMIN
  SUPPORT
  MERCHANT
  OWNER
  REFERRAL
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  twoFaSecret   String?   @map("two_fa_secret")
  referredById  String?   @map("referred_by_id") @db.Uuid
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions                    Session[]
  merchant                    Merchant?
  traderProfile               TraderProfile?
  payoutTraderProfile         PayoutTraderProfile?
  referralProfile             ReferralProfile?
  referrer                    ReferralProfile?     @relation("ReferredUsers", fields: [referredById], references: [id])
  auditLogs                   AuditLog[]
  settlements                      Settlement[]                    @relation("SettlementAdmin")
  uploadedFiles                    File[]
  balanceTransactionsCreated       BalanceTransaction[]            @relation("BalanceTxCreator")
  platformWithdrawals              PlatformWithdrawal[]
  coverageNominalsCreated          CoverageNominalSetting[]
  cascadeSettingsUpdates           CascadeSetting[]
  payoutPoolSettingsUpdates        PayoutPoolSetting[]             @relation("PayoutPoolSettingUpdater")
  merchantPayoutPoolAssignments    MerchantPayoutPoolAssignment[] @relation("MerchantPayoutPoolAssignmentCreator")
  payoutTraderBalanceTxCreated     PayoutTraderBalanceTransaction[] @relation("PayoutTraderBalanceTxCreator")
  payoutTraderSettlementRequestsResolved PayoutTraderSettlementRequest[] @relation("PayoutTraderSettlementRequestResolver")

  @@index([referredById])
  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Referral Profiles ───

model ReferralProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  referralPercent Decimal  @default(0) @map("referral_percent") @db.Decimal(8, 4)
  balance         Decimal  @default(0) @db.Decimal(18, 4)
  currencyId      String   @map("currency_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  referrals User[] @relation("ReferredUsers")

  @@index([currencyId])
  @@map("referral_profiles")
}

// ─── Merchants ───

model Merchant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  /// Human-readable label; unique across merchants for admin lookups (e.g. pay-out pool B).
  name      String   @unique
  isLock    Boolean  @default(false) @map("is_lock")
  createdAt DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys                     MerchantApiKey[]
  balances                    MerchantBalance[]
  payinOrders                 PayinOrder[]
  payoutOrders                PayoutOrder[]
  merchantDirections          MerchantDirection[]
  merchantBalanceTransactions MerchantBalanceTransaction[]
  platformIncomeRows          PlatformIncome[]
  payoutPoolAssignment        MerchantPayoutPoolAssignment?
  settlements                  Settlement[]

  @@map("merchants")
}

enum ApiKeyDirection {
  PAYIN
  PAYOUT
}

model MerchantApiKey {
  id            String          @id @default(uuid()) @db.Uuid
  merchantId    String          @map("merchant_id") @db.Uuid
  direction     ApiKeyDirection
  publicKey     String          @unique @map("public_key")
  secretKeyHash String          @map("secret_key_hash")
  isActive      Boolean         @default(true) @map("is_active")
  revokedAt     DateTime?       @map("revoked_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([publicKey])
  @@index([merchantId, direction])
  @@map("merchant_api_keys")
}

model MerchantBalance {
  id         String  @id @default(uuid()) @db.Uuid
  merchantId String  @map("merchant_id") @db.Uuid
  currencyId String  @map("currency_id") @db.Uuid
  amount     Decimal @default(0) @db.Decimal(18, 4)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([merchantId, currencyId])
  @@index([currencyId])
  @@map("merchant_balances")
}

// ─── Currencies & Directions ───

model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  referralProfiles                 ReferralProfile[]
  merchantBalances                 MerchantBalance[]
  directionsFrom                   Direction[]                         @relation("DirectionFromCurrency")
  directionsTo                     Direction[]                         @relation("DirectionToCurrency")
  countries                        Country[]
  payoutTraderBalanceTransactions PayoutTraderBalanceTransaction[]
  merchantDirections               MerchantDirection[]
  balanceTransactions              BalanceTransaction[]
  traderBalances                   TraderBalance[]
  requisiteGroups                  RequisiteGroup[]
  requisites                       Requisite[]
  payinOrders                      PayinOrder[]
  payoutOrders                     PayoutOrder[]
  settlements                      Settlement[]
  merchantBalanceTransactions      MerchantBalanceTransaction[]
  cascadeLevelDebt                 CascadeLevelDebt?

  @@map("currencies")
}

enum DirectionType {
  PAYIN
  PAYOUT
}

model Direction {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  type           DirectionType
  fromCurrencyId String        @map("from_currency_id") @db.Uuid
  toCurrencyId   String        @map("to_currency_id") @db.Uuid
  minAmount      Decimal       @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount      Decimal       @default(0) @map("max_amount") @db.Decimal(18, 4)
  percentFee     Decimal       @default(0) @map("percent_fee") @db.Decimal(8, 4)
  isOnline       Boolean       @default(true) @map("is_online")
  createdAt      DateTime      @default(now()) @map("created_at")

  fromCurrency Currency @relation("DirectionFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency @relation("DirectionToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@index([fromCurrencyId])
  @@index([toCurrencyId])
  @@map("directions")
}

// ─── Geo: Countries ───

model Country {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  currencyId String   @map("currency_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  currency              Currency              @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  paymentMethods        PaymentMethod[]
  payoutTraderProfiles PayoutTraderProfile[]

  @@index([currencyId])
  @@map("countries")
}

/// Pay-Out specialist (pool B) profile — separate from standard TraderProfile.
model PayoutTraderProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  countryId      String   @map("country_id") @db.Uuid
  balanceUsdt    Decimal  @default(0) @map("balance_usdt") @db.Decimal(18, 6)
  payoutRate     Decimal  @default(0) @map("payout_rate") @db.Decimal(8, 6)
  exchangeParser String?  @map("exchange_parser") @db.VarChar(64)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  country             Country                         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  payoutOrders        PayoutOrder[]
  settlements         Settlement[]
  balanceTransactions PayoutTraderBalanceTransaction[]
  telegramSettings    PayoutTraderTelegramSettings?
  settlementRequests  PayoutTraderSettlementRequest[]

  @@map("payout_traders")
}

enum PayoutTraderSettlementRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

model PayoutTraderSettlementRequest {
  id             String                           @id @default(uuid()) @db.Uuid
  payoutTraderId String                           @map("payout_trader_id") @db.Uuid
  amountUsdt     Decimal                          @map("amount_usdt") @db.Decimal(18, 6)
  note           String?
  status         PayoutTraderSettlementRequestStatus @default(PENDING)
  createdAt      DateTime                         @default(now()) @map("created_at")
  resolvedAt     DateTime?                        @map("resolved_at")
  resolvedById   String?                          @map("resolved_by_id") @db.Uuid

  payoutTrader PayoutTraderProfile @relation(fields: [payoutTraderId], references: [id], onDelete: Cascade)
  resolvedBy   User?               @relation("PayoutTraderSettlementRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([payoutTraderId])
  @@index([status])
  @@map("payout_trader_settlement_requests")
}

model PayoutPoolSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  poolBGlobalPercent Decimal  @default(0) @map("pool_b_global_percent") @db.Decimal(5, 2)
  poolTimeoutHours   Int?     @map("pool_timeout_hours")
  poolTimeoutEnabled Boolean  @default(false) @map("pool_timeout_enabled")
  /// When true, specialist "fail" from PROCESSING returns the order to pool B (PENDING) without merchant refund.
  specialistFailReturnsToPool Boolean @default(false) @map("specialist_fail_returns_to_pool")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedById        String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("PayoutPoolSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("payout_pool_settings")
}

model MerchantPayoutPoolAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @unique @map("merchant_id") @db.Uuid
  poolBPercent  Decimal  @default(0) @map("pool_b_percent") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("MerchantPayoutPoolAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("merchant_payout_pool_assignments")
}

model PayoutTraderTelegramSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  payoutTraderId     String   @unique @map("payout_trader_id") @db.Uuid
  chatId             String?  @map("chat_id")
  notifyNewPoolOrder Boolean  @default(true) @map("notify_new_pool_order")
  notifySettlement   Boolean  @default(true) @map("notify_settlement")
  isActive           Boolean  @default(false) @map("is_active")

  payoutTrader PayoutTraderProfile @relation(fields: [payoutTraderId], references: [id], onDelete: Cascade)

  @@map("payout_trader_telegram_settings")
}

enum PayoutTraderBalanceTxType {
  PAYOUT_CREDIT
  SETTLEMENT_DEBIT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

model PayoutTraderBalanceTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  payoutTraderId String                   @map("payout_trader_id") @db.Uuid
  type           PayoutTraderBalanceTxType
  amount         Decimal                  @db.Decimal(18, 6)
  currencyId     String                   @map("currency_id") @db.Uuid
  referenceId    String?                  @map("reference_id") @db.Uuid
  createdById    String?                  @map("created_by_id") @db.Uuid
  comment        String?
  createdAt      DateTime                 @default(now()) @map("created_at")

  payoutTrader PayoutTraderProfile @relation(fields: [payoutTraderId], references: [id], onDelete: Cascade)
  currency     Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("PayoutTraderBalanceTxCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([payoutTraderId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("payout_trader_balance_transactions")
}

// ─── Payment Methods ───

enum PaymentMethodFlowType {
  P2P
  P2C
  CRYPTO
}

enum PaymentMethodRequisiteType {
  CARD
  IBAN
  WALLET
}

enum PaymentMethodAvailability {
  PAYIN
  PAYOUT
  BOTH
}

model PaymentMethod {
  id            String                     @id @default(uuid()) @db.Uuid
  countryId     String                     @map("country_id") @db.Uuid
  name          String                     @unique
  displayName   String                     @map("display_name")
  flowType      PaymentMethodFlowType      @map("flow_type")
  requisiteType PaymentMethodRequisiteType @map("requisite_type")
  availability  PaymentMethodAvailability
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at")

  country            Country             @relation(fields: [countryId], references: [id])
  merchantDirections MerchantDirection[]
  payinOrders        PayinOrder[]
  payoutOrders       PayoutOrder[]
  requisiteGroups    RequisiteGroup[]

  @@index([countryId, isActive])
  @@map("payment_methods")
}

// ─── Merchant Directions (per-merchant settings) ───

model MerchantDirection {
  id                      String        @id @default(uuid()) @db.Uuid
  merchantId              String        @map("merchant_id") @db.Uuid
  paymentMethodId         String?       @map("payment_method_id") @db.Uuid
  directionType           DirectionType @map("direction_type")
  currencyId              String        @map("currency_id") @db.Uuid
  minAmount               Decimal       @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount               Decimal       @default(0) @map("max_amount") @db.Decimal(18, 4)
  defaultCommissionPercent Decimal      @default(0) @map("default_commission_percent") @db.Decimal(8, 4)
  isActive                Boolean       @default(true) @map("is_active")
  createdAt               DateTime      @default(now()) @map("created_at")

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  currency        Currency         @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  commissionTiers MerchantCommissionTier[]
  blockedAmounts  MerchantBlockedAmount[]

  @@unique([merchantId, directionType, currencyId])
  @@index([merchantId, directionType])
  @@index([currencyId])
  @@map("merchant_directions")
}

model MerchantBlockedAmount {
  id                  String   @id @default(uuid()) @db.Uuid
  merchantDirectionId String   @map("merchant_direction_id") @db.Uuid
  amount              Decimal  @db.Decimal(18, 4)
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")

  merchantDirection MerchantDirection @relation(fields: [merchantDirectionId], references: [id], onDelete: Cascade)

  @@unique([merchantDirectionId, amount])
  @@index([merchantDirectionId])
  @@map("merchant_blocked_amounts")
}

// ─── Merchant Commission Tiers ───

model MerchantCommissionTier {
  id                  String   @id @default(uuid()) @db.Uuid
  merchantDirectionId String   @map("merchant_direction_id") @db.Uuid
  amountFrom          Decimal  @map("amount_from") @db.Decimal(18, 4)
  amountTo            Decimal? @map("amount_to") @db.Decimal(18, 4)
  commissionPercent   Decimal  @map("commission_percent") @db.Decimal(8, 4)

  merchantDirection MerchantDirection @relation(fields: [merchantDirectionId], references: [id], onDelete: Cascade)

  @@index([merchantDirectionId])
  @@map("merchant_commission_tiers")
}

// ─── Balance Transactions ───

enum BalanceTransactionType {
  PAYIN_COMMISSION
  PAYIN_DEBIT
  PAYOUT_DEBIT
  PAYOUT_CREDIT
  TOP_UP
  OVERDRAFT_SET
  SETTLEMENT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

model BalanceTransaction {
  id          String                 @id @default(uuid()) @db.Uuid
  traderId    String                 @map("trader_id") @db.Uuid
  type        BalanceTransactionType
  amount      Decimal                @db.Decimal(18, 4)
  currencyId  String                 @map("currency_id") @db.Uuid
  referenceId String?                @map("reference_id") @db.Uuid
  createdById String?                @map("created_by_id") @db.Uuid
  comment     String?
  createdAt   DateTime               @default(now()) @map("created_at")

  trader    TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  currency  Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("BalanceTxCreator", fields: [createdById], references: [id])

  @@index([traderId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("balance_transactions")
}

// ─── Traders & Requisites ───

enum TraderProcessingMethod {
  CARD
  FORK

  @@map("trader_processing_method")
}

enum CascadeLevelPickMode {
  DEBT
  STOCHASTIC

  @@map("cascade_level_pick_mode")
}

enum CascadeAssignmentLevel {
  FORK
  CARD
  PROVIDER

  @@map("cascade_assignment_level")
}

model TraderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  acceptingOrders Boolean  @default(true) @map("accepting_orders")
  payoutMinLimit  Decimal  @default(0) @map("payout_min_limit") @db.Decimal(18, 4)
  payoutMaxLimit  Decimal  @default(0) @map("payout_max_limit") @db.Decimal(18, 4)
  /// USDT overdraft limit (0 = no overdraft). Available for Pay-In assignment = balance_usdt + overdraft_limit.
  overdraftLimit  Decimal  @default(0) @map("overdraft_limit") @db.Decimal(18, 6)
  /// Trader Pay-In rate as fraction (0.01 = +1% on parser rate divisor).
  payinRate       Decimal  @default(0) @map("payin_rate") @db.Decimal(8, 6)
  /// Trader Pay-Out rate as fraction (0.002 = 0.2% better credit).
  payoutRate      Decimal  @default(0) @map("payout_rate") @db.Decimal(8, 6)
  /// TRC-20 receiving address for USDT top-ups (Tron). Monitored by deposit worker when set.
  usdtTrc20DepositAddress String? @map("usdt_trc20_deposit_address") @db.VarChar(64)
  /// ERC-20 receiving address for USDT top-ups (Ethereum mainnet). Monitored by ERC-20 deposit worker when set.
  usdtErc20DepositAddress String? @map("usdt_erc20_deposit_address") @db.VarChar(42)
  /// Pay-In cascade: CARD vs FORK (affects Fork autolimits only).
  processingMethod TraderProcessingMethod @default(CARD) @map("processing_method")
  /// Pay-In idle-race multiplier for this trader (1 = default).
  cascadeRatingMultiplier Decimal @default(1) @map("cascade_rating_multiplier") @db.Decimal(12, 6)
  createdAt       DateTime @default(now()) @map("created_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances            TraderBalance[]
  requisites          Requisite[]
  requisiteGroups     RequisiteGroup[]
  payinOrders         PayinOrder[]
  payoutOrders        PayoutOrder[]
  telegramSettings    TelegramSettings?
  settlements         Settlement[]
  balanceTransactions BalanceTransaction[]
  walletDeposits      WalletDeposit[]
  traderWallet        TraderWallet?
  walletSweepLogs     WalletSweepLog[]
  platformIncomeRows  PlatformIncome[]
  trafficDistributionLogs TrafficDistributionLog[]

  @@map("trader_profiles")
}

/// Custodial TRON deposit address (BIP44 / Vault). One per trader; mirrors `usdt_trc20_deposit_address` for workers.
model TraderWallet {
  id              String   @id @default(uuid()) @db.Uuid
  traderId        String   @unique @map("trader_id") @db.Uuid
  address         String   @unique @db.VarChar(42)
  derivationIndex Int      @unique @map("derivation_index")
  vaultPath       String   @map("vault_path") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([address])
  @@map("trader_wallets")
}

enum WalletSweepStatus {
  PENDING
  BROADCAST
  CONFIRMED
  FAILED
}

model WalletSweepLog {
  id          String            @id @default(uuid()) @db.Uuid
  traderId    String            @map("trader_id") @db.Uuid
  fromAddress String            @map("from_address") @db.VarChar(42)
  toAddress   String            @map("to_address") @db.VarChar(42)
  txHash      String?           @unique @map("tx_hash") @db.VarChar(128)
  amountUsdt  Decimal           @map("amount_usdt") @db.Decimal(20, 6)
  feeTrx      Decimal           @default(0) @map("fee_trx") @db.Decimal(20, 6)
  status      WalletSweepStatus @default(PENDING)
  error       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  confirmedAt DateTime?         @map("confirmed_at")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@map("wallet_sweep_logs")
}

model CascadeSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Fraction of remaining capacity at which Fork autolimits activate (e.g. 0.20).
  autolimitThreshold Decimal  @default(0.20) @map("autolimit_threshold") @db.Decimal(8, 6)
  autolimitEnabled   Boolean  @default(true) @map("autolimit_enabled")
  /// Target share of Pay-In assignments routed to Fork trader pool (0–100); trio should sum to 100.
  forkTrafficPercent     Decimal @default(70) @map("fork_traffic_percent") @db.Decimal(8, 4)
  cardTrafficPercent     Decimal @default(30) @map("card_traffic_percent") @db.Decimal(8, 4)
  providerTrafficPercent Decimal @default(0) @map("provider_traffic_percent") @db.Decimal(8, 4)
  levelPickMode          CascadeLevelPickMode @default(DEBT) @map("level_pick_mode")
  /// Optional JSON array of { from, to, multiplier } for Fork fill_multiplier (TZ §7.3); null = app defaults.
  fillMultipliersConfig Json? @map("fill_multipliers_config")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedById        String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("cascade_settings")
}

/// Per-currency accumulators for deterministic primary-level selection (method-level debt / credits).
model CascadeLevelDebt {
  id             String   @id @default(uuid()) @db.Uuid
  currencyId     String   @unique @map("currency_id") @db.Uuid
  forkCredit     Decimal  @default(0) @map("fork_credit") @db.Decimal(24, 12)
  cardCredit     Decimal  @default(0) @map("card_credit") @db.Decimal(24, 12)
  providerCredit Decimal  @default(0) @map("provider_credit") @db.Decimal(24, 12)
  updatedAt      DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@map("cascade_level_debts")
}

model TrafficDistributionLog {
  id               String                 @id @default(uuid()) @db.Uuid
  traderId         String                 @map("trader_id") @db.Uuid
  payinOrderId     String                 @unique @map("payin_order_id") @db.Uuid
  amount           Decimal                @db.Decimal(18, 4)
  processingMethod TraderProcessingMethod @map("processing_method")
  cascadeAssignmentLevel CascadeAssignmentLevel? @map("cascade_assignment_level")
  cascadePrimaryAssignmentLevel CascadeAssignmentLevel? @map("cascade_primary_assignment_level")
  createdAt        DateTime               @default(now()) @map("created_at")

  trader     TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  payinOrder PayinOrder    @relation(fields: [payinOrderId], references: [id], onDelete: Cascade)

  @@index([traderId, createdAt])
  @@map("traffic_distribution_logs")
}

model CoverageNominalSetting {
  id          String   @id @default(uuid()) @db.Uuid
  amount      Decimal  @db.Decimal(18, 4)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("coverage_nominal_settings")
}

model TraderBalance {
  id         String  @id @default(uuid()) @db.Uuid
  traderId   String  @map("trader_id") @db.Uuid
  currencyId String  @map("currency_id") @db.Uuid
  amount     Decimal @default(0) @db.Decimal(18, 4)
  /// Cumulative on-chain USDT credited via wallet deposits (TZ `trader_balances.total_deposited`). Meaningful when currency is USDT.
  totalDeposited Decimal @default(0) @map("total_deposited") @db.Decimal(20, 6)

  trader   TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  currency Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([traderId, currencyId])
  @@index([currencyId])
  @@map("trader_balances")
}

enum RequisiteType {
  CARD
  IBAN
}

enum RequisiteDisabledReason {
  LIMIT_AMOUNT
  LIMIT_TX
  MANUAL
}

model RequisiteGroup {
  id              String    @id @default(uuid()) @db.Uuid
  traderId        String    @map("trader_id") @db.Uuid
  name            String
  currencyId      String    @map("currency_id") @db.Uuid
  paymentMethodId String    @map("payment_method_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  archivedAt      DateTime? @map("archived_at")
  deactivatedAt   DateTime? @map("deactivated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trader         TraderProfile  @relation(fields: [traderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  currency       Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  requisites     Requisite[]

  @@index([traderId, archivedAt])
  @@index([currencyId])
  @@map("requisite_groups")
}

model Requisite {
  id                String                   @id @default(uuid()) @db.Uuid
  traderId          String                   @map("trader_id") @db.Uuid
  requisiteGroupId  String                   @map("requisite_group_id") @db.Uuid
  type              RequisiteType
  number            String
  /// Normalized identifier for cross-platform uniqueness while active (see migrations).
  numberNormalized  String                   @map("number_normalized")
  owner             String
  /// Full legal name of the card/account holder (surname, given name, patronymic).
  cardHolderName    String                   @default("") @map("card_holder_name")
  bankId            Int?                     @map("bank_id")
  code              String?
  isActive          Boolean                  @default(true) @map("is_active")
  disabledReason    RequisiteDisabledReason? @map("disabled_reason")
  acceptsOtherBanks Boolean                  @default(false) @map("accepts_other_banks")
  minAmount         Decimal                  @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxAmount         Decimal                  @default(999999999) @map("max_amount") @db.Decimal(18, 4)
  limitTotalAmount  Decimal                  @default(999999999) @map("limit_total_amount") @db.Decimal(18, 4)
  limitTotalOps     Int                      @default(999999) @map("limit_total_ops")
  usedAmount        Decimal                  @default(0) @map("used_amount") @db.Decimal(18, 4)
  /// Sum of Pay-In amounts in terminal paid outcomes (PAID / UNDERPAID / OVERPAID) for Fork fill_multiplier (TZ §3.4).
  confirmedPayinAmount Decimal               @default(0) @map("confirmed_payin_amount") @db.Decimal(18, 4)
  usedOps           Int                      @default(0) @map("used_ops")
  currencyId        String                   @map("currency_id") @db.Uuid
  /// Baseline for Pay-In cascade idle-time race; reset on assignment and when min/max amounts change.
  cascadeIdleAnchorAt DateTime               @default(now()) @map("cascade_idle_anchor_at")
  /// Count of Pay-In orders assigned to this requisite (newcomer boost while zero).
  payinAssignmentsCount Int                  @default(0) @map("payin_assignments_count")
  createdAt         DateTime                 @default(now()) @map("created_at")

  trader        TraderProfile  @relation(fields: [traderId], references: [id], onDelete: Cascade)
  group         RequisiteGroup @relation(fields: [requisiteGroupId], references: [id], onDelete: Restrict)
  bank          Bank?          @relation(fields: [bankId], references: [id])
  currency      Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  payinOrders   PayinOrder[]

  @@index([traderId, isActive])
  @@index([currencyId, isActive])
  @@index([requisiteGroupId])
  @@map("requisites")
}

// ─── Banks ───

model Bank {
  id        Int     @id @default(autoincrement())
  name      String
  logoFileId String? @map("logo_file_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")

  logoFile   File?       @relation(fields: [logoFileId], references: [id])
  requisites Requisite[]

  @@map("banks")
}

// ─── Pay-In Orders ───

enum PayinStatus {
  PENDING
  NEW
  VERIFIED
  PAID
  UNDERPAID
  OVERPAID
  APPEAL
  CANCELED
  UPLOAD_FAILED
  /// No trader requisite could accept this Pay-In (see cascade routing).
  NO_REQUISITE
}

/// Stored on Pay-In orders with status NO_REQUISITE (cascade could not assign).
enum PayinNoRequisiteReason {
  NO_ACTIVE_REQUISITES
  REQUISITE_TOTAL_LIMIT_EXCEEDED
  NO_MATCHING_AMOUNT_OR_RANGE
  USDT_CAPACITY_INSUFFICIENT
  PROVIDER_DECLINED
  PROVIDER_UNAVAILABLE
  ASSIGNMENT_CONTENTION
}

model PayinOrder {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @map("request_id")
  merchantId        String      @map("merchant_id") @db.Uuid
  traderId          String?     @map("trader_id") @db.Uuid
  requisiteId       String?     @map("requisite_id") @db.Uuid
  paymentMethodId   String?     @map("payment_method_id") @db.Uuid
  amount            Decimal     @db.Decimal(18, 4)
  /// Fiat amount recorded when order reaches PAID/UNDERPAID/OVERPAID (reverses requisite confirmed_payin_amount on APPEAL).
  receivedFiatAmount Decimal?   @map("received_fiat_amount") @db.Decimal(18, 4)
  /// External Pay-In provider reference when assigned via provider bridge (TZ §5–6).
  providerExternalRef String? @map("provider_external_ref") @db.VarChar(512)
  currencyId        String      @map("currency_id") @db.Uuid
  commissionPercent Decimal     @default(0) @map("commission_percent") @db.Decimal(8, 4)
  commission        Decimal     @default(0) @db.Decimal(18, 4)
  partnerAmount     Decimal     @default(0) @map("partner_amount") @db.Decimal(18, 4)
  rate              Decimal     @default(1) @db.Decimal(18, 8)
  /// Parser reference rate P (local fiat per 1 USDT), captured when the order uses a Binance-backed snapshot.
  parserRate        Decimal?    @map("parser_rate") @db.Decimal(12, 6)
  rateTraderIn      Decimal?    @map("rate_trader_in") @db.Decimal(12, 6)
  rateAdminIn       Decimal?    @map("rate_admin_in") @db.Decimal(12, 6)
  status            PayinStatus @default(PENDING)
  /// Why cascade could not assign a requisite when status is NO_REQUISITE.
  noRequisiteReason PayinNoRequisiteReason? @map("no_requisite_reason")
  /// Optional English diagnostic snapshot (cascade evaluate detail, truncated).
  noRequisiteDetail String?     @map("no_requisite_detail") @db.VarChar(512)
  userFullName      String?     @map("user_full_name")
  userIdExternal    String?     @map("user_id_external")
  callbackUrl       String?     @map("callback_url")
  redirectUrl       String?     @map("redirect_url")
  autocloseAt       DateTime?   @map("autoclose_at")
  confirmedAt       DateTime?   @map("confirmed_at")
  completedAt       DateTime?   @map("completed_at")
  isH2h             Boolean     @default(false) @map("is_h2h")
  /// Snapshot of trader cascade method when requisite is assigned; null for NO_REQUISITE or rows without a captured method (see traffic_distribution_logs / migrations).
  traderProcessingMethod TraderProcessingMethod? @map("trader_processing_method")
  /// FORK flow: optional exchange / counterparty reference (set by trader).
  forkExchangeReference String? @map("fork_exchange_reference") @db.VarChar(512)
  /// Client IP on external API order creation (first X-Forwarded-For hop or socket IP).
  partnerIp         String?     @map("partner_ip") @db.VarChar(45)
  /// External merchant API path that created this row (e.g. /api/external/v1/payin/upload_order).
  externalApiPath   String?     @map("external_api_path") @db.VarChar(512)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  trader        TraderProfile? @relation(fields: [traderId], references: [id])
  requisite     Requisite?     @relation(fields: [requisiteId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  currency      Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  appeals       Appeal[]
  webhookOutbox WebhookOutbox[]
  trafficDistributionLog TrafficDistributionLog?
  forkChatProofs PayinForkChatProof[]
  payerPaymentProofs PayinPayerPaymentProof[]
  assignmentLog PayinOrderAssignmentLog?

  @@unique([merchantId, requestId])
  @@index([status])
  @@index([merchantId])
  @@index([traderId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("payin_orders")
}

model PayinOrderAssignmentLog {
  id                        String   @id @default(uuid()) @db.Uuid
  payinOrderId              String   @unique @map("payin_order_id") @db.Uuid
  amount                    Decimal  @db.Decimal(18, 4)
  currencyCode              String   @map("currency_code") @db.VarChar(16)
  primaryBucket             CascadeAssignmentLevel @map("primary_bucket")
  finalBucket               CascadeAssignmentLevel @map("final_bucket")
  isFallback                Boolean  @default(false) @map("is_fallback")
  /// True when primary tier was PROVIDER and the order landed on PROVIDER (counts toward provider share plan per TZ §5.4).
  providerTrafficPlanHit    Boolean  @default(false) @map("provider_traffic_plan_hit")
  createdAt                 DateTime @default(now()) @map("created_at")

  payinOrder PayinOrder @relation(fields: [payinOrderId], references: [id], onDelete: Cascade)

  @@map("payin_order_assignment_logs")
}

// ─── Pay-Out Orders ───

enum PayoutStatus {
  PENDING
  NEW
  PROCESSING
  COMPLETED
  FAILED
  UPLOAD_FAILED
}

enum PayoutDetailsType {
  CARD
  IBAN
}

enum PayoutPoolType {
  STANDARD
  PAYOUT_SPECIALIST
}

enum PayoutTraderRejectReason {
  FOREIGN_CARD
  CARD_REFUND_IN_PROGRESS
  OTHER
}

model PayoutOrder {
  id              String            @id @default(uuid()) @db.Uuid
  requestId       String            @map("request_id")
  merchantId      String            @map("merchant_id") @db.Uuid
  traderId        String?           @map("trader_id") @db.Uuid
  payoutTraderId  String?           @map("payout_trader_id") @db.Uuid
  paymentMethodId String?           @map("payment_method_id") @db.Uuid
  amount          Decimal           @db.Decimal(18, 4)
  currencyId      String            @map("currency_id") @db.Uuid
  status          PayoutStatus      @default(PENDING)
  poolType        PayoutPoolType    @default(STANDARD) @map("pool_type")
  poolAssignedAt  DateTime?         @map("pool_assigned_at")
  detailsType     PayoutDetailsType @map("details_type")
  detailsNumber   String            @map("details_number")
  detailsOwner    String?           @map("details_owner")
  detailsCode     String?           @map("details_code")
  rate            Decimal           @default(1) @db.Decimal(18, 8)
  commissionAmount Decimal          @default(0) @map("commission_amount") @db.Decimal(18, 4)
  partnerAmount   Decimal           @default(0) @map("partner_amount") @db.Decimal(18, 4)
  percentFee      Decimal           @default(0) @map("percent_fee") @db.Decimal(8, 4)
  /// Parser reference rate P (local fiat per 1 USDT), captured when the order uses a Binance-backed snapshot.
  parserRate      Decimal?          @map("parser_rate") @db.Decimal(12, 6)
  rateTraderOut   Decimal?          @map("rate_trader_out") @db.Decimal(12, 6)
  rateAdminOut    Decimal?          @map("rate_admin_out") @db.Decimal(12, 6)
  /// Total fiat (order currency) reserved from merchant at creation: face amount × (1 + commission).
  merchantDebitLocal Decimal?        @map("merchant_debit_local") @db.Decimal(18, 2)
  callbackUrl     String?           @map("callback_url")
  startAt         DateTime?         @map("start_at")
  endAt           DateTime?         @map("end_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  merchant        Merchant            @relation(fields: [merchantId], references: [id])
  trader          TraderProfile?      @relation(fields: [traderId], references: [id])
  payoutTrader    PayoutTraderProfile? @relation(fields: [payoutTraderId], references: [id])
  paymentMethod   PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  currency        Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  completionProofFileId String?      @map("completion_proof_file_id") @db.Uuid
  completionProofFile File?        @relation("PayoutOrderCompletionProof", fields: [completionProofFileId], references: [id], onDelete: SetNull)
  /// When status is FAILED after trader/specialist rejection (card inactive / funds returned).
  traderRejectReason PayoutTraderRejectReason? @map("trader_reject_reason")
  /// Plain-language detail when `traderRejectReason` is OTHER (cabinet-required copy).
  traderRejectOtherNote String? @map("trader_reject_other_note") @db.Text
  /// Client IP on external API order creation (first X-Forwarded-For hop or socket IP).
  partnerIp       String?           @map("partner_ip") @db.VarChar(45)
  /// External merchant API path that created this row (e.g. /api/external/v1/payout/order_upload).
  externalApiPath String?           @map("external_api_path") @db.VarChar(512)
  webhookOutbox   WebhookOutbox[]
  completionProofAttachments PayoutCompletionProofAttachment[]

  @@unique([merchantId, requestId])
  @@index([status])
  @@index([merchantId])
  @@index([traderId])
  @@index([payoutTraderId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("payout_orders")
}

/// Pay-Out cabinet: one or more receipt files linked when completing or after completion (like appeal proofs).
model PayoutCompletionProofAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  payoutOrderId   String   @map("payout_order_id") @db.Uuid
  fileId          String   @map("file_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  payoutOrder PayoutOrder @relation(fields: [payoutOrderId], references: [id], onDelete: Cascade)
  file        File        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([payoutOrderId, fileId])
  @@index([payoutOrderId])
  @@map("payout_completion_proof_attachments")
}

