  rate      Decimal  @db.Decimal(12, 6)
  rawPrices Json     @map("raw_prices")
  source    String   @default("binance_p2p")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("exchange_rate_logs")
}

enum PlatformIncomeOrderType {
  PAYIN
  PAYOUT
}

model PlatformIncome {
  id                    String                  @id @default(uuid()) @db.Uuid
  orderId               String                  @map("order_id") @db.Uuid
  orderType             PlatformIncomeOrderType @map("order_type")
  merchantId            String                  @map("merchant_id") @db.Uuid
  traderId              String?                 @map("trader_id") @db.Uuid
  orderAmountLocal      Decimal                 @map("order_amount_local") @db.Decimal(18, 2)
  /// Snapshot parser reference P (same fiat currency as order_amount_local, per 1 USDT).
  parserRate            Decimal                 @map("parser_rate") @db.Decimal(12, 6)
  rateTrader            Decimal                 @map("rate_trader") @db.Decimal(12, 6)
  rateAdmin             Decimal                 @map("rate_admin") @db.Decimal(12, 6)
  traderRatePct         Decimal                 @map("trader_rate_pct") @db.Decimal(8, 6)
  merchantCommissionPct Decimal               @map("merchant_commission_pct") @db.Decimal(8, 6)
  incomeUsdt            Decimal                 @map("income_usdt") @db.Decimal(18, 6)
  /// Platform margin leg booked in the same fiat unit as order_amount_local (margin_usdt × parser_rate snapshot).
  incomeLocal           Decimal                 @map("income_local") @db.Decimal(18, 2)
  createdAt             DateTime                @default(now()) @map("created_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  trader   TraderProfile?    @relation(fields: [traderId], references: [id], onDelete: SetNull)

  @@unique([orderId, orderType])
  @@index([merchantId])
  @@index([createdAt])
  @@map("platform_income")
}

enum MerchantBalanceTransactionType {
  PAYIN_CREDIT
  PAYOUT_DEBIT
  PAYOUT_REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  TOP_UP
  /// Fiat withdrawal booked against the merchant ledger when an admin confirms a settlement payout.
  SETTLEMENT
}

model MerchantBalanceTransaction {
  id          String                         @id @default(uuid()) @db.Uuid
  merchantId  String                         @map("merchant_id") @db.Uuid
  type        MerchantBalanceTransactionType
  amount      Decimal                        @db.Decimal(18, 2)
  currencyId  String                         @map("currency_id") @db.Uuid
  referenceId String?                        @map("reference_id") @db.Uuid
  comment     String?
  createdAt   DateTime                       @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("merchant_balance_transactions")
}

enum BlockchainNetwork {
  TRC20
  ERC20
}

enum WalletDepositStatus {
  PENDING
  CONFIRMED
  CREDITED
  FAILED
}

model WalletDeposit {
  id            String              @id @default(uuid()) @db.Uuid
  traderId      String              @map("trader_id") @db.Uuid
  txHash        String              @unique @map("tx_hash") @db.VarChar(128)
  network       BlockchainNetwork
  amountUsdt    Decimal             @map("amount_usdt") @db.Decimal(18, 6)
  confirmations Int                 @default(0)
  status        WalletDepositStatus @default(PENDING)
  /// Receiving deposit address (TRON base58) when known from chain monitoring.
  toAddress     String?             @map("to_address") @db.VarChar(42)
  blockNumber   BigInt?             @map("block_number")
  creditedAt    DateTime?           @map("credited_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)
  topUpSettlement Settlement? @relation("WalletDepositTopUpSettlement")

  @@index([traderId])
  @@map("deposits")
}

model PlatformWithdrawal {
  id                  String            @id @default(uuid()) @db.Uuid
  amountUsdt          Decimal           @map("amount_usdt") @db.Decimal(18, 6)
  coldWalletAddress   String            @map("cold_wallet_address") @db.VarChar(128)
  network             BlockchainNetwork
  txHash              String?           @map("tx_hash") @db.VarChar(128)
  initiatedById       String?           @map("initiated_by") @db.Uuid
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at")

  initiatedBy User? @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@map("platform_withdrawals")
}

// ─── Platform Settings ───

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

// ─── Telegram Notifications ───

model TelegramSettings {
  id            String  @id @default(uuid()) @db.Uuid
  traderId      String  @unique @map("trader_id") @db.Uuid
  chatId        String? @map("chat_id")
  notifyPayin   Boolean @default(false) @map("notify_payin")
  notifyPayout  Boolean @default(false) @map("notify_payout")
  notifyAppeals Boolean @default(false) @map("notify_appeals")
  /// Settlements handbook 1.3 — alert when remaining Pay-In capacity (USDT) is at/below the operator threshold.
  notifyLowPayinCapacity    Boolean @default(true) @map("notify_low_payin_capacity")
  /// Settlements handbook 1.3 — notify when a TOP_UP ledger credit is recorded (on-chain or manual confirmation).
  notifyTopUpConfirm      Boolean @default(true) @map("notify_top_up_confirm")
  /// Settlements handbook 1.3 — trader + ops when USDT capacity is fully exhausted (no headroom for Pay-In).
  notifyPayinCapacityExhausted Boolean @default(true) @map("notify_payin_capacity_exhausted")
  isActive      Boolean @default(false) @map("is_active")

  trader TraderProfile @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@map("telegram_settings")
}
