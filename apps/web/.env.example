# Public API origin for browser fetches (internal dashboard + External API playground)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Telegram bot username (without @) — used for Connect Bot deep links in trader / specialist cabinets
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Hide /external-api-playground at runtime: set false, 0, no, or off. Omit or true = route allowed (layout is opt-out).
EXTERNAL_PLAYGROUND_ENABLED=true
