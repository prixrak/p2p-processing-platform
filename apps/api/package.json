{
  "name": "@p2p/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --files -r tsconfig-paths/register src/main.ts",
    "dev:worker": "ts-node --files -r tsconfig-paths/register src/worker.main.ts",
    "dev:watch": "nest start --watch --entryFile apps/api/src/main",
    "build": "nest build",
    "start": "node dist/apps/api/src/main",
    "start:prod": "node dist/apps/api/src/main",
    "start:worker": "node dist/apps/api/src/worker.main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@noble/secp256k1": "^3.1.0",
    "@p2p/config": "*",
    "@p2p/prisma": "*",
    "@p2p/shared": "*",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bip39": "^3.1.0",
    "bs58check": "^4.0.0",
    "bullmq": "^5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "ethereum-cryptography": "^3.2.0",
    "hdkey": "^2.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.2.0",
    "node-vault": "^0.12.0",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tronweb": "^6.3.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bs58check": "^2.1.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
