# syntax=docker/dockerfile:1
# Base from ECR Public (mirrors Docker Hub) to avoid transient registry-1.docker.io outages in CI.
# Target linux/amd64 for AWS EC2; avoids arm64 images when building on Apple Silicon.
ARG TARGETPLATFORM=linux/amd64
FROM --platform=$TARGETPLATFORM public.ecr.aws/docker/library/node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY packages/prisma/package.json packages/prisma/
COPY packages/config/package.json packages/config/
RUN npm ci --workspace=apps/api --workspace=packages/shared --workspace=packages/prisma --workspace=packages/config

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate --schema=packages/prisma/prisma/schema.prisma
RUN npm run build --workspace=@p2p/config --workspace=@p2p/shared --workspace=@p2p/prisma \
  && npm run build --workspace=apps/api

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/packages/prisma/prisma ./prisma
COPY --from=builder /app/packages/config ./packages/config
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/prisma/package.json ./packages/prisma/package.json
COPY --from=builder /app/packages/prisma/dist ./packages/prisma/dist

EXPOSE 3001
CMD ["node", "dist/apps/api/src/main.js"]
