# ─── Application ───
NODE_ENV=production
PORT=3001
BASE_URL=https://api.p2p-processing-dev.com
# Browser origin(s) allowed by CORS — match the URL users open for the web app
FRONTEND_URL=https://p2p-processing-dev.com

# ─── Database (AWS RDS PostgreSQL) ───
DATABASE_URL=postgresql://p2p_user:STRONG_PASSWORD_HERE@your-rds-endpoint.rds.amazonaws.com:5432/p2p_prod

# ─── Redis (local in Docker, with password) ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ─── JWT Auth ───
JWT_SECRET=GENERATE_WITH__openssl_rand_-hex_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── S3 (AWS) ───
S3_BUCKET=your-p2p-files-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=AKIA...YOUR_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET
S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT not needed for real AWS S3

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your-bot-token

# ─── Docker Compose vars ───
# Required for `aws ecr get-login-password` on the server (must match ECR registry region)
AWS_REGION=eu-central-1
ECR_REGISTRY=123456789.dkr.ecr.eu-central-1.amazonaws.com
IMAGE_TAG=latest
API_PUBLIC_URL=https://api.p2p-processing-dev.com

# ─── Web (Next.js) — optional ───
# Set to "true" to expose /external-api-playground (requires image built with INCLUDE_EXTERNAL_PLAYGROUND=true)
# EXTERNAL_PLAYGROUND_ENABLED=false
