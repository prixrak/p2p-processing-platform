# ─── Application ───
NODE_ENV=production
PORT=3001
BASE_URL=https://api.example.com
# Browser origin for CORS — must match the dashboard URL users open
FRONTEND_URL=https://example.com

# ─── Database (e.g. AWS RDS PostgreSQL) ───
DATABASE_URL=postgresql://p2p_user:STRONG_PASSWORD_HERE@your-rds-endpoint.rds.amazonaws.com:5432/p2p_prod

# ─── Redis (Docker service name `redis` on the Compose network) ───
REDIS_HOST=redis
REDIS_PORT=6379
# Optional; when set, must match docker-compose.prod.yml Redis `requirepass` and this file on api/worker.
REDIS_PASSWORD=

# ─── JWT / crypto ───
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_64
# Application secrets (e.g. TOTP encryption) — min 32 chars; use openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Internal HTTP (required in production) ───
INTERNAL_API_KEY=GENERATE_WITH_openssl_rand_-hex_32

# ─── AWS Secrets Manager (optional) ───
# JSON secret: { "JWT_SECRET": "...", "DATABASE_URL": "...", ... } — keys are env var names.
# Loaded before startup validation; merged over variables from this file. Refreshed periodically unless POLL_MS=0.
# IAM: instance role needs secretsmanager:GetSecretValue on the secret.
# AWS_SECRETS_MANAGER_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:123456789012:secret:p2p/prod-xxxx
# or: AWS_SECRETS_MANAGER_SECRET_ID=p2p/prod
# AWS_SECRETS_MANAGER_POLL_MS=300000

# ─── S3 (AWS) ───
S3_BUCKET=your-p2p-files-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=AKIA...YOUR_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET
S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT not needed for real AWS S3

# ─── Telegram Bot (optional) ───
TELEGRAM_BOT_TOKEN=
OWNER_OPS_TELEGRAM_CHAT_ID=

# ─── Reverse proxy / TLS (nginx container) ───
# Primary site hostname (apex). Certificates: first certbot -d should match NGINX_TLS_CERT_NAME.
NGINX_SITE_DOMAIN=example.com
# Let's Encrypt live cert folder name under /etc/letsencrypt/live/
NGINX_TLS_CERT_NAME=example.com

# ─── Docker Compose / CI deploy ───
AWS_REGION=eu-central-1
ECR_REGISTRY=123456789.dkr.ecr.eu-central-1.amazonaws.com
IMAGE_TAG=latest
API_PUBLIC_URL=https://api.example.com

# ─── Web (Next.js) — optional ───
# Build-time: set GitHub repository variable INCLUDE_EXTERNAL_PLAYGROUND=false to omit playground from images.
# Runtime: hide route when image still includes playground code.
EXTERNAL_PLAYGROUND_ENABLED=false

# ─── Tron / deposits / sweep (enable only what you use) ───
# TRONGRID_API_KEY=
# TRONGRID_BASE_URL=https://api.trongrid.io
# TRON_DEPOSIT_POLL_ENABLED=true
# TRON_DEPOSIT_POLL_MODE=per_account
# TRON_USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TRON_USDT_MIN_CONFIRMATIONS=19
# TRON_DEPOSIT_MIN_USDT=1
# TRON_SWEEP_ENABLED=false
# TRON_SWEEP_COLD_WALLET_ADDRESS=
# TRON_SWEEP_THRESHOLD_USDT=1000
# TRON_SWEEP_TRX_RESERVE=5
# TRON_RESOURCE_DELEGATION_ENABLED=false
TRON_SWEEP_REQUIRE_VAULT_SECP_ENGINE=false

# ─── Ethereum (optional) ───
# ETH_DEPOSIT_POLL_ENABLED=false
# ETH_RPC_URL=

# ─── HashiCorp Vault (Docker service `vault`) ───
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=secret
VAULT_WALLET_COUNTER_PATH=wallet_counter
VAULT_MASTER_SEED_PATH=master_seed
VAULT_WALLET_PREFIX_PATH=wallets
VAULT_WALLET_ROLE_ID=
VAULT_WALLET_SECRET_ID=
VAULT_SWEEP_ROLE_ID=
VAULT_SWEEP_SECRET_ID=
# VAULT_TRON_SECP_SIGN_MOUNT=tron-sign

# ─── Optional ops email (see root .env.example) ───
# OPS_ALERT_EMAILS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# OPS_EMAIL_FROM=
# OPS_EMAIL_MIN_SEVERITY=high

# ─── Optional Pay-In provider bridge ───
# PAYIN_PROVIDER_BASE_URL=
# PAYIN_PROVIDER_API_KEY=
# PAYIN_PROVIDER_WEBHOOK_SECRET=
