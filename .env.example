# ─── Application ───
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Auth ───
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── S3 (file storage — appeals, proofs, logos) ───
# Use ONE mode. Real AWS locally: set bucket/region/keys; leave S3_ENDPOINT unset.
# MinIO (docker compose): set S3_ENDPOINT to localhost:9000 as below.

# --- Real AWS S3 (local API → your dev bucket) ---
# S3_BUCKET=p2p-files-dev
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
# (omit S3_ENDPOINT entirely for AWS)

# --- MinIO (default: matches `docker compose`; console http://localhost:9001) ---
S3_BUCKET=p2p-files
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Telegram Bot (optional) ───
TELEGRAM_BOT_TOKEN=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:3001
