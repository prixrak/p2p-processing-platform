# ─── Application ───
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2p

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Auth ───
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── S3 (file storage — appeals, proofs, logos) ───
# Use ONE mode. Real AWS locally: set bucket/region/keys; leave S3_ENDPOINT unset.
# MinIO (docker compose): set S3_ENDPOINT to localhost:9000 as below.

# --- Real AWS S3 (local API → your dev bucket) ---
# S3_BUCKET=p2p-files-dev
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
# (omit S3_ENDPOINT entirely for AWS)

# --- MinIO (default: matches `docker compose`; console http://localhost:9001) ---
S3_BUCKET=p2p-files
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Telegram Bot (optional) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public webhook URL for production (e.g. https://api.example.com/api/telegram/bot/webhook). Leave empty for long polling (dev).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
OWNER_OPS_TELEGRAM_CHAT_ID=

# ─── Ops email alerts via SMTP (optional; Gmail: App Password + smtp.gmail.com:587) ───
# OPS_ALERT_EMAILS=ops@example.com,oncall@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# OPS_EMAIL_FROM=
# OPS_EMAIL_MIN_SEVERITY=high
# OPS_EMAIL_THROTTLE_CRITICAL_SEC=3600
# OPS_EMAIL_THROTTLE_HIGH_SEC=1800
# OPS_EMAIL_THROTTLE_MEDIUM_SEC=900
# OPS_EMAIL_THROTTLE_LOW_SEC=600

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:3001
