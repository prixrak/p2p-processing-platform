# syntax=docker/dockerfile:1
# ECR Public mirror of docker.io/library/node — more reliable for CI than Docker Hub alone.
ARG TARGETPLATFORM=linux/amd64
FROM --platform=$TARGETPLATFORM public.ecr.aws/docker/library/node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace=apps/web --workspace=packages/shared

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN mkdir -p apps/web/public
ENV NEXT_TELEMETRY_DISABLED=1
# Baked into client bundle at build time — override when building the image
ARG NEXT_PUBLIC_API_URL=https://api.p2p-processing-dev.com
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
# Include External API playground in the client bundle (set to false to strip via webpack alias)
ARG INCLUDE_EXTERNAL_PLAYGROUND=true
ENV INCLUDE_EXTERNAL_PLAYGROUND=${INCLUDE_EXTERNAL_PLAYGROUND}
RUN npm run build --workspace=apps/web

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
CMD ["node", "apps/web/server.js"]
