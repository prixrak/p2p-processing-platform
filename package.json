{
  "name": "p2p-processing-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev:worker --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:config": "npm run build --workspace=@p2p/config",
    "build:api": "npm run build:config && npm run build --workspace=apps/api",
    "start:worker": "npm run start:worker --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace=packages/prisma",
    "db:migrate:reset": "npm run migrate:reset --workspace=packages/prisma",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=packages/prisma",
    "db:generate": "npm run generate --workspace=packages/prisma",
    "db:seed": "npm run seed --workspace=packages/prisma",
    "db:bootstrap": "npm run bootstrap --workspace=packages/prisma",
    "db:studio": "npm run studio --workspace=packages/prisma",
    "hmac:example": "node scripts/example-external-hmac.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
